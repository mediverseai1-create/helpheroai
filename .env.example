# Supabase (public: safe in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role: SERVER ONLY. Used by the billing webhook and public chat. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# AI provider (Gemini). Server only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Payment links (one per plan/interval). Provided by owner.
NEXT_PUBLIC_PAYMENT_LINK_STARTER_MONTHLY=https://selar.com/47plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_STARTER_ANNUAL=
NEXT_PUBLIC_PAYMENT_LINK_GROWTH_MONTHLY=https://selar.com/57plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_GROWTH_ANNUAL=
NEXT_PUBLIC_PAYMENT_LINK_SCALE_MONTHLY=https://selar.com/97plan?currency=USD
NEXT_PUBLIC_PAYMENT_LINK_SCALE_ANNUAL=
# Shared secret to verify payment webhooks (HMAC-SHA256 of raw body, hex, header x-helphero-signature)
BILLING_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
